# Telegram bot token
TELEGRAM_BOT_TOKEN=

# Telegram chat id (user, group, or channel id)
TELEGRAM_CHAT_ID=

# Public report base URL (GitHub Pages, gh-pages branch of this repo)
REPORT_BASE_URL=https://dear-linko.github.io/html-url-crawl

# Domain registration lookup (stability-first defaults for cron)
DOMAIN_REG_LOOKUP_LIMIT=400
DOMAIN_REG_LOOKUP_TIMEOUT=6
DOMAIN_REG_LOOKUP_RETRIES=3
DOMAIN_REG_LOOKUP_BACKOFF=0.8
